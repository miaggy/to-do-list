{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "to-do-list",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Whisper do Workers AI para transcrever a voz (sem chave)
  "ai": { "binding": "AI" },
  "vars": {
    // Públicos (os mesmos do .env do app)
    "SUPABASE_URL": "https://idwqgmplhodkkuhckhvs.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_nYP6uBcMWDk3U0qgJdcn0g_1bTl1LbA",
    "TRANSCRIBE_BASE_URL": "https://api.openai.com/v1",
    "TRANSCRIBE_MODEL": "gpt-4o-mini-transcribe"
  }
  // Opcional, para usar OpenAI/Groq no lugar do Workers AI:
  // npx wrangler secret put TRANSCRIBE_API_KEY
}
